# PostgreSQL connection URL. Do not commit a real value.
DATABASE_URL=

# Set to false only when required by the local SSL environment.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# JWT signing secret used by authenticated user APIs.
JWT_SECRET=

# Shared key for POST /api/internal/program-cases/sync.
INTERNAL_API_KEY=

# Comma-separated exact host allowlist for attachment downloads.
ATTACHMENT_ALLOWED_HOSTS=www.geumjeong.go.kr
ATTACHMENT_DOWNLOAD_TIMEOUT_MS=20000
ATTACHMENT_HEAD_TIMEOUT_MS=10000
ATTACHMENT_MAX_FILE_SIZE_BYTES=31457280
ATTACHMENT_MAX_REDIRECTS=3
ATTACHMENT_EXTRACTION_CONCURRENCY=1
# Optional. Defaults to a moira-attachment-extraction directory under the OS temp directory.
ATTACHMENT_TEMP_DIR=
