# PostgreSQL connection URL. Do not commit a real value.
DATABASE_URL=
# Separate disposable DB only. Its database name must contain test or integration.
TEST_DATABASE_URL=

# Set to false only when required by the local SSL environment.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# JWT signing secret used by authenticated user APIs.
JWT_SECRET=

# Shared key for POST /api/internal/program-cases/sync.
INTERNAL_API_KEY=

# Comma-separated exact host allowlist for attachment downloads.
ATTACHMENT_ALLOWED_HOSTS=www.geumjeong.go.kr
ATTACHMENT_DOWNLOAD_TIMEOUT_MS=20000
ATTACHMENT_HEAD_TIMEOUT_MS=10000
ATTACHMENT_MAX_FILE_SIZE_BYTES=31457280
ATTACHMENT_MAX_REDIRECTS=3
ATTACHMENT_EXTRACTION_CONCURRENCY=1
# Optional. Defaults to a moira-attachment-extraction directory under the OS temp directory.
ATTACHMENT_TEMP_DIR=

# Bounded, read-only HWP/HWPX structure analysis.
HWP_ANALYSIS_TIMEOUT_MS=600000
HWP_OLE_MAX_DIRECTORY_ENTRIES=2048
HWP_OLE_MAX_STREAM_BYTES=4194304
HWP_ZIP_MAX_ENTRIES=1024
HWP_ZIP_MAX_ENTRY_BYTES=8388608
HWP_ZIP_MAX_TOTAL_BYTES=31457280
HWP_ZIP_MAX_COMPRESSION_RATIO=100

# HWP text extraction through one isolated kordoc subprocess at a time.
HWP_EXTRACTION_TIMEOUT_MS=60000
HWP_EXTRACTION_OUTPUT_MAX_BYTES=5242880
HWP_EXTRACTION_OUTPUT_MAX_CHARACTERS=5000000
HWP_EXTRACTION_MIN_CHARACTERS=10
HWP_EXTRACTION_MAX_REPLACEMENT_PER_10000=100

# NAVER Cloud CLOVA OCR General API V2. Keep real values only in .env.
CLOVA_OCR_ENABLED=false
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=
CLOVA_OCR_TIMEOUT_MS=30000
CLOVA_OCR_RESPONSE_MAX_BYTES=5242880
CLOVA_OCR_MAX_RETRIES=1

# MIXED PDF page rendering. Do not pass executable paths through CLI options.
ATTACHMENT_PDF_RENDER_EXECUTABLE=pdftocairo
ATTACHMENT_PDF_RENDER_TIMEOUT_MS=30000
ATTACHMENT_PDF_RENDER_DPI=200
ATTACHMENT_PDF_OCR_MAX_PAGES=50
ATTACHMENT_PDF_RENDER_MAX_BYTES=20971520

# Optional local-only KURE semantic search settings. DATABASE_URL is reused.
# Defaults to the user Hugging Face cache. Inside apps/backend only
# apps/backend/.model-cache is allowed, and it is ignored by Git.
KURE_MODEL_CACHE_DIR=
KURE_BATCH_SIZE=8
