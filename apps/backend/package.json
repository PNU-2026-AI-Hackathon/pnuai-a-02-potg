{
  "name": "pnuai-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:seed": "prisma db seed",
    "db:verify:interests": "node prisma/verify-interests.js",
    "test:program-case-sync": "npm run build && node scripts/test-program-case-sync.js",
    "test:attachment-preservation": "npm run build && node scripts/test-attachment-preservation.js",
    "test:attachment-regression": "npm run build && node scripts/test-attachment-regression.js",
    "test:attachment-extraction": "npm run build && node scripts/test-attachment-modules.js && node scripts/test-attachment-extraction-state.js",
    "test:attachment-ocr": "npm run build && node scripts/test-attachment-ocr.js",
    "test:image-ocr-cli": "npm run build && node scripts/test-image-ocr-cli.js",
    "verify:image-ocr-write": "npm run build && node scripts/verify-image-ocr-write.js",
    "analyze:image-ocr-duplicates": "npm run build && node scripts/analyze-image-ocr-duplicates.js",
    "extract:program-attachments": "npm run build && node dist/cli/extractProgramAttachments.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
