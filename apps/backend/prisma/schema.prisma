generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  RESIDENT
  LIBRARIAN
  ADMIN
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum AttachmentExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProgramCaseDocumentChunkType {
  CORE
  SESSIONS
  ATTACHMENT
}

enum ProgramCaseDocumentChunkEmbeddingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id          String         @id @default(uuid())
  userId      String?        @unique
  name        String
  email       String         @unique
  password    String
  accountType AccountType    @default(RESIDENT)
  gender      Gender?
  birthDate   DateTime?
  region      String?
  phone       String?
  interests   UserInterest[]
  posts       CommunityPost[]
  comments    CommunityComment[]
  postLikes   CommunityPostLike[]
  savedPosts  CommunityPostSave[]
  studioDocuments StudioDocument[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Interest {
  id        String         @id
  name      String         @unique
  users     UserInterest[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, interestId])
  @@index([interestId])
}

model CommunityPost {
  id           String   @id @default(uuid())
  boardSlug    String
  type         String
  title        String
  content      String
  author       String
  tags         String[]
  passwordHash String?
  authorId     String?
  authorUser   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  comments     CommunityComment[]
  likes        CommunityPostLike[]
  saves        CommunityPostSave[]

  @@index([boardSlug])
  @@index([type])
  @@index([createdAt])
  @@index([authorId, createdAt])
}

model CommunityComment {
  id        String             @id @default(uuid())
  postId    String
  parentId  String?
  content   String
  author    String
  authorId  String?
  authorUser User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  post      CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[] @relation("CommentReplies")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId, createdAt])
}

model CommunityPostLike {
  userId    String
  postId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([userId, postId])
  @@index([postId])
  @@index([userId, createdAt])
}

model CommunityPostSave {
  userId    String
  postId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([userId, postId])
  @@index([postId])
  @@index([userId, createdAt])
}

model ProgramCase {
  id                     String                  @id @default(uuid())
  sourceType             String
  sourcePostId           String
  sourceUrl              String
  title                  String
  targetAudience         String
  instructor             String
  capacity               Int
  currentApplicants      Int
  applicationStatus      String
  educationStartDate     DateTime
  educationEndDate       DateTime
  educationStartDateText String
  educationEndDateText   String
  location               String?
  feeText                String?
  preparationText        String?
  contactText            String?
  notices                String                  @db.Text
  rawText                String                  @db.Text
  hasUnparsedAttachments Boolean
  crawledAt              DateTime
  requestSucceeded       Boolean
  parseWarnings          Json
  sessions               ProgramCaseSession[]
  attachments            ProgramCaseAttachment[]
  documents              ProgramCaseDocument[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([sourceType, sourcePostId])
  @@index([applicationStatus])
  @@index([educationStartDate])
  @@index([educationEndDate])
}

model ProgramCaseSession {
  id            String      @id @default(uuid())
  programCaseId String
  sessionNumber Int
  sessionDate   DateTime?
  dateText      String
  activity      String      @db.Text
  sortOrder     Int
  programCase   ProgramCase @relation(fields: [programCaseId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([programCaseId, sessionNumber])
}

model ProgramCaseAttachment {
  id               String                     @id @default(uuid())
  programCaseId    String
  fileName         String
  fileUrl          String
  fileType         String?
  detectedFileType String?
  detectedMimeType String?
  fileSizeBytes    Int?
  checksumSha256   String?
  extractionStatus AttachmentExtractionStatus @default(PENDING)
  rawText          String?                    @db.Text
  cleanedText      String?                    @db.Text
  extractorType    String?
  extractorVersion String?
  failureCode      String?
  failureMessage   String?                    @db.Text
  attemptCount     Int                        @default(0)
  lastAttemptedAt  DateTime?
  extractedAt      DateTime?
  isActive         Boolean                    @default(true)
  programCase      ProgramCase                @relation(fields: [programCaseId], references: [id], onDelete: Cascade)
  documentChunks   ProgramCaseDocumentChunk[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([programCaseId, fileUrl])
}

model ProgramCaseDocument {
  id            String      @id @default(uuid())
  programCaseId String
  documentType  String
  content       String      @db.Text
  contentHash   String
  version       String
  programCase   ProgramCase @relation(fields: [programCaseId], references: [id], onDelete: Cascade)
  chunks        ProgramCaseDocumentChunk[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([programCaseId, documentType])
  @@index([documentType])
}

model ProgramCaseDocumentChunk {
  id                      String                       @id @default(uuid())
  programCaseDocumentId   String
  programCaseAttachmentId String?
  chunkKey                String
  chunkOrder              Int
  chunkType               ProgramCaseDocumentChunkType
  sourceLabel             String?
  content                 String                       @db.Text
  contentHash             String
  builderVersion          String
  characterCount          Int
  programCaseDocument     ProgramCaseDocument          @relation(fields: [programCaseDocumentId], references: [id], onDelete: Cascade)
  programCaseAttachment   ProgramCaseAttachment?       @relation(fields: [programCaseAttachmentId], references: [id], onDelete: Cascade)
  embedding               ProgramCaseDocumentChunkEmbedding?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  @@unique([programCaseDocumentId, chunkKey])
  @@index([programCaseDocumentId, chunkOrder])
  @@index([programCaseAttachmentId])
  @@index([chunkType])
}

model ProgramCaseDocumentChunkEmbedding {
  id                         String                                  @id @default(uuid())
  programCaseDocumentChunkId String                                  @unique(map: "ProgramCaseChunkEmbedding_chunkId_key")
  embedding                  Unsupported("vector(1024)")?
  provider                   String
  model                      String
  modelRevision              String
  embeddingVersion           String
  dimension                  Int
  embeddedContentHash        String?
  status                     ProgramCaseDocumentChunkEmbeddingStatus @default(PENDING)
  failureCode                String?
  failureMessage             String?                                 @db.VarChar(500)
  attemptCount               Int                                     @default(0)
  lastAttemptedAt            DateTime?
  embeddedAt                 DateTime?
  programCaseDocumentChunk   ProgramCaseDocumentChunk                @relation(fields: [programCaseDocumentChunkId], references: [id], onDelete: Cascade, map: "ProgramCaseChunkEmbedding_chunkId_fkey")
  createdAt                  DateTime                                @default(now())
  updatedAt                  DateTime                                @updatedAt

  @@index([status])
  @@index([provider, model, modelRevision], map: "ProgramCaseChunkEmbedding_modelRevision_idx")
}

model StudioDocument {
  id               String   @id @default(uuid())
  ownerId          String?
  anonymousOwnerId String?
  title            String
  content          String   @db.Text
  stage            String   @default("기획 중")
  conditions       Json?
  agenda           Json?
  // 기획서의 항목 구조. 본문은 사람이 읽는 글이라 다시 항목으로 쪼갤 수 없어,
  // 항목 하나만 고치려면 이 구조가 문서와 함께 남아 있어야 한다.
  plan             Json?
  // 수요조사 결과 요약. 사서가 사전 검토를 끝낸 뒤 반영 여부를 확인하는 데 사용한다.
  surveyResult     Json?
  owner            User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@index([anonymousOwnerId, updatedAt])
}
